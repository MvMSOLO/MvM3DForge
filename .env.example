# Copy this template to .env for local work; never put real credentials here.
# A durable account/project store requires a real PostgreSQL URL.
# Leave blank until you provide a developer-owned database; no dummy URL is valid.
DATABASE_URL=

# Optional direct/unpooled URL for migrations. Defaults to DATABASE_URL when unset.
DATABASE_URL_MIGRATIONS=

# Production's canonical origin. For local development, set this to
# http://localhost:8080 or leave it unset.
BETTER_AUTH_URL=https://mvm3d.vercel.app

# Optional server-only Better Auth secret. Leave blank unless intentionally configured.
# Never rename this to a VITE_* variable.
BETTER_AUTH_SECRET=

# Optional canonical OAuth/MCP issuer origin. Usually inferred from Vercel in production.
# For local development, set this to http://localhost:8080 or leave it unset.
MCP_PUBLIC_URL=https://mvm3d.vercel.app
